{
  "dependencies": {
    "busboy": "1.6.0",
    "dotenv": "18.0.5",
    "express": "5.2.1",
    "mysql2": "3.24.5",
    "nodemailer": "9.1.1",
    "sequelize": "6.37.8",
    "yauzl": "3.4.0"
  },
  "name": "node-factore-v1",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Factor E - CRM, asignaciones y campus privado",
  "engines": {
    "node": ">=18.16.0"
  },
  "scripts": {
    "modelos:verificar": "node Scripts/verificar-modelos.js",
    "modelos:db": "node Scripts/verificar-modelos.js --db",
    "archivos:verificar": "node Scripts/verificar-controladores-archivos.js",
    "archivos:inicializar": "node Scripts/inicializar-storage.js",
    "archivos:reintentar": "node Scripts/reintentar-eliminaciones.js",
    "test": "node --test Tests/*.test.js",
    "archivos:recuperar": "node Scripts/recuperar-subidas.js",
    "usuarios:verificar": "node Scripts/verificar-controladores-usuarios.js",
    "admin:crear": "node Scripts/crear-admin.js",
    "accesos:verificar": "node Scripts/verificar-controladores-accesos.js",
    "campus:verificar": "node Scripts/verificar-controladores-campus.js",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "rutas:verificar": "node Scripts/verificar-rutas.js",
    "auth:probar": "node Scripts/probar-login.js"
  },
  "overrides": {
    "sequelize": {
      "uuid": "11.1.1"
    }
  }
}
