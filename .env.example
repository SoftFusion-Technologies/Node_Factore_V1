# Factor E | Desarrollo local | Copiar a .env solo al instalar desde cero.
NODE_ENV=development
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=DB_FactoreDesa_04102026
DB_USER=root
DB_PASSWORD="COMPLETAR_PASSWORD_MYSQL"
DB_SOCKET=
DB_POOL_SIZE=10
DB_SSL=false
DB_SSL_CA_FILE=

# Si tu .env existente omite estas variables se usan estos mismos valores.
HOST=127.0.0.1
PORT=3001
TRUST_PROXY=false
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
SESSION_HOURS=12

# Ruta relativa a Node_Factore_V1; fuera de cualquier carpeta pública.
STORAGE_ROOT=../factore-storage-desa
MAX_VIDEO_BYTES=1073741824
MAX_IMAGE_BYTES=10485760
MAX_DOCUMENT_BYTES=26214400
UPLOAD_TIMEOUT_MS=1800000
